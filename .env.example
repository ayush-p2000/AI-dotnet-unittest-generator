# ==============================================================================
# AI Provider Configuration: Choose between Local Ollama (Qwen 3 Coder) & Google Gemini
# ==============================================================================
# Default AI Provider: "ollama" or "gemini"
AI_PROVIDER=ollama

# --- Option A: Local Ollama (Qwen 3 Coder) ---
# No API key required. Runs completely locally on your GPU/CPU.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3-coder:latest

# --- Option B: Google Gemini API (Google AI Studio) ---
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Additional keys for automatic failover rotation on rate limits
GEMINI_API_KEY_2=your_second_gemini_key_here
GEMINI_API_KEY_3=your_third_gemini_key_here

# --- Option C: Qwen Cloud / DashScope (Optional) ---
# For Alibaba Cloud Model Studio or OpenRouter
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your_qwen_api_key_here

# ==============================================================================
# SonarQube / SonarCloud Configuration (Cognitive Complexity Auto-Fixer)
# ==============================================================================
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonarqube_token_here
SONAR_PROJECT_KEY=your_project_key
# (Optional) Required only if using SonarCloud
SONAR_ORGANIZATION=
