# ==============================================================================
# AI Provider Configuration: Google Gemini
# ==============================================================================
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# --- Google Gemini API (Google AI Studio) ---
# https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Additional keys for automatic failover rotation on rate limits
GEMINI_API_KEY_2=your_second_gemini_key_here
GEMINI_API_KEY_3=your_third_gemini_key_here

# ==============================================================================
# Context Window & Token Limits (Google Gemini)
# ==============================================================================
# 1. Input Context Limit (in tokens):
#    Controls max input context size for Gemini and prompt dependency budgeting.
#    Recommended: 32768, 65536, 131072 (default: 32768)
CONTEXT_LIMIT=32768

# 2. Maximum Generation Output Tokens (max_tokens):
#    Controls how many tokens Gemini can generate in a single response.
#    Default: 8192 (sufficient for generating complete test files with 500-800 lines)
MAX_OUTPUT_TOKENS=8192

# 3. Maximum Dependency Context Characters (Optional Safety Cap):
#    Caps raw characters of referenced classes/interfaces injected into prompt.
#    Default: 60000 (leave empty for unlimited, CONTEXT_LIMIT automatically manages token budget).
MAX_CONTEXT_CHARS=60000

# ==============================================================================
# SonarQube / SonarCloud Configuration (Cognitive Complexity Auto-Fixer)
# ==============================================================================
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonarqube_token_here
SONAR_PROJECT_KEY=your_project_key
# (Optional) Required only if using SonarCloud
SONAR_ORGANIZATION=
